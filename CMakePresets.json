{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x86-debug",
      "displayName": "Win32 x86 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/x86-debug",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x86-release",
      "displayName": "Win32 x86 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/x86-release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-x86-debug",
      "displayName": "Linux i386 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_OVERLAY_TRIPLETS": "$env{VCPKG_ROOT}/triplets/community",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-x86-release",
      "displayName": "Linux i386 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_OVERLAY_TRIPLETS": "$env{VCPKG_ROOT}/triplets/community",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "configuration": "Release"
    },
    {
      "name": "linux-x86-debug",
      "configurePreset": "linux-x86-debug"
    },
    {
      "name": "linux-x86-release",
      "configurePreset": "linux-x86-release"
    }
  ],
  "testPresets": [
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86-debug",
      "configurePreset": "linux-x86-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86-release",
      "configurePreset": "linux-x86-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
